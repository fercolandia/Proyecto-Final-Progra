<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <None Update="conexion.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Form1.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form1.Designer.cs">
      <DependentUpon>Form1.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Form1.resx">
      <DependentUpon>Form1.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Presentacion\LoginForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Presentacion\LoginForm.Designer.cs">
      <DependentUpon>LoginForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Presentacion\LoginForm.resx">
      <DependentUpon>LoginForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Presentacion\IngresoForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Presentacion\IngresoForm.Designer.cs">
      <DependentUpon>IngresoForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Presentacion\IngresoForm.resx">
      <DependentUpon>IngresoForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Presentacion\EditorForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Presentacion\EditorForm.Designer.cs">
      <DependentUpon>EditorForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Presentacion\EditorForm.resx">
      <DependentUpon>EditorForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Presentacion\TicketForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Presentacion\TicketForm.Designer.cs">
      <DependentUpon>TicketForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Presentacion\TicketForm.resx">
      <DependentUpon>TicketForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Form1.Operacion.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Form1.Operacion.Designer.cs">
      <DependentUpon>Form1.Operacion.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Form1.Operacion.resx">
      <DependentUpon>Form1.Operacion.cs</DependentUpon>
      <LogicalName>Parqueo.Form1Operaciones.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>